<?xml version="1.0" encoding="UTF-8"?>
<!-- GreenNotebook dark GtkSourceView style scheme. -->
<style-scheme id="greennotebook-dark" _name="GreenNotebook Dark" version="1.0">
  <author>GreenNotebook contributors</author>
  <_description>Dark editing palette for GreenNotebook</_description>

  <color name="background" value="#202923"/>
  <color name="foreground" value="#e7eee9"/>
  <color name="muted" value="#a7b5ab"/>
  <color name="selection" value="#286342"/>
  <color name="current" value="#2a362e"/>
  <color name="green" value="#65d58a"/>
  <color name="blue" value="#7cb7e8"/>
  <color name="purple" value="#d7a6d1"/>
  <color name="orange" value="#efb56f"/>
  <color name="red" value="#ff8585"/>
  <color name="yellow" value="#e8d56f"/>

  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" foreground="foreground" background="selection"/>
  <style name="current-line" background="current"/>
  <style name="current-line-number" background="current"/>
  <style name="draw-spaces" foreground="muted"/>
  <style name="right-margin" foreground="muted" background="current"/>
  <style name="search-match" foreground="#161b17" background="yellow"/>
  <style name="bracket-match" foreground="foreground" background="selection"/>
  <style name="bracket-mismatch" foreground="foreground" background="red"/>

  <style name="def:comment" foreground="blue"/>
  <style name="def:shebang" foreground="blue" bold="true"/>
  <style name="def:constant" foreground="purple"/>
  <style name="def:special-char" foreground="purple"/>
  <style name="def:identifier" foreground="blue"/>
  <style name="def:statement" foreground="red" bold="true"/>
  <style name="def:type" foreground="green" bold="true"/>
  <style name="def:preprocessor" foreground="orange"/>
  <style name="def:error" foreground="foreground" background="#8d3434" bold="true"/>
  <style name="def:warning" foreground="#161b17" background="orange"/>
  <style name="def:note" foreground="#161b17" background="yellow" bold="true"/>
  <style name="def:underlined" underline="single"/>

  <style name="def:heading0" scale="5.0"/>
  <style name="def:heading1" scale="2.5"/>
  <style name="def:heading2" scale="2.0"/>
  <style name="def:heading3" scale="1.7"/>
  <style name="def:heading4" scale="1.5"/>
  <style name="def:heading5" scale="1.3"/>
  <style name="def:heading6" scale="1.2"/>

  <style name="t2t:strikethrough" strikethrough="true"/>
  <style name="t2t:bold" bold="true"/>
  <style name="t2t:url" underline="single" foreground="blue"/>
  <style name="t2t:link-url" foreground="blue"/>
  <style name="t2t:hashtag" foreground="red"/>
  <style name="t2t:entry-reference" foreground="blue"/>
</style-scheme>
